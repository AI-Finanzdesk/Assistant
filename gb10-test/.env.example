# Kopieer naar gb10-test/.env en pas aan. Dit bestand gaat niet mee in git.

# Adres van de lokale modelserver (OpenAI-compatibel):
#   Ollama: http://localhost:11434/v1   ·   vLLM: http://localhost:8000/v1
LOCAL_LLM_URL=http://localhost:11434/v1
# Te vergelijken modellen, met komma's (namen zoals de server ze kent)
LOCAL_MODELS=gpt-oss:120b,mistral-small3.2

# Taal van de samenvattingen (de of nl), projectnaam en deelnemers zoals in de app
TEST_LANGUAGE=de
TEST_PROJECT=Testprojekt
TEST_PARTICIPANTS=
TEST_TOPICS=Energieeinkauf,THG-Quote,Fördermittel

# Alleen voor "npm run gb10-test -- --claude" (vergelijking met Claude via Google Cloud in de EU):
# VERTEX_PROJECT_ID=
# VERTEX_REGION=eu
# GOOGLE_SERVICE_ACCOUNT_JSON=
