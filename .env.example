# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side! Nooit in de browser gebruiken.
SUPABASE_SERVICE_ROLE_KEY=

# --- Publieke URL van de app (zonder slash aan het eind) ---
APP_URL=http://localhost:3000

# --- Claude ---
# Optie A: Google Vertex AI in de EU (aanbevolen: verwerking blijft in de EU).
# Google Cloud-project-ID; als dit is ingevuld wordt Vertex gebruikt en is ANTHROPIC_API_KEY niet nodig.
VERTEX_PROJECT_ID=
# "eu" (EU-regio's) of een specifieke regio zoals europe-west1. Nooit "global" als data in de EU moet blijven.
VERTEX_REGION=eu
# Inhoud van het JSON-sleutelbestand van het serviceaccount (rol "Vertex AI User"), op één regel.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optie B: rechtstreeks bij Anthropic (console.anthropic.com → API keys). Verwerking niet gegarandeerd in de EU.
ANTHROPIC_API_KEY=

# --- Transcriptie: AssemblyAI (EU-regio) ---
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com

# --- Exchange op eigen server (EWS) ---
# Adres van Exchange Web Services, bv. https://mail.firma.de/EWS/Exchange.asmx
EWS_URL=
# Sleutel voor het versleutelen van Exchange-wachtwoorden: openssl rand -hex 32
CREDENTIALS_KEY=

# --- Optioneel: Microsoft 365 / Exchange Online (Entra ID app-registratie) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common", "organizations" of de tenant-ID van jullie Microsoft 365
MS_TENANT_ID=organizations

# --- Geheimen voor webhooks en cron-jobs (lange willekeurige strings) ---
WEBHOOK_SECRET=
CRON_SECRET=
