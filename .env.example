# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side! Nooit in de browser gebruiken.
SUPABASE_SERVICE_ROLE_KEY=

# --- Publieke URL van de app (zonder slash aan het eind) ---
APP_URL=http://localhost:3000

# --- Claude (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=

# --- Transcriptie: AssemblyAI (EU-regio) ---
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com

# --- Microsoft 365 / Exchange Online (Entra ID app-registratie) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common", "organizations" of de tenant-ID van jullie Microsoft 365
MS_TENANT_ID=organizations

# --- Geheimen voor webhooks en cron-jobs (lange willekeurige strings) ---
WEBHOOK_SECRET=
CRON_SECRET=
